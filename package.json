{
  "name": "dsh-open-in-editor",
  "version": "0.3.0",
  "description": "Open DSH Web produced files in a configurable local macOS IDE or copy their absolute paths.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-open-in-editor": "bin/dsh-open-in-editor.js"
  },
  "files": [
    "bin/dsh-open-in-editor.js",
    "cordis.patch.yml",
    "lib/editor-host.js",
    "lib/index.js",
    "lib/client.js",
    "lib/installer.js",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/*.js bin/*.js && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "clipboard",
    "macos",
    "zed",
    "vscode",
    "editor"
  ],
  "author": "shaomingbo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaomingbo/dsh-open-in-editor.git"
  },
  "homepage": "https://github.com/shaomingbo/dsh-open-in-editor#readme",
  "bugs": {
    "url": "https://github.com/shaomingbo/dsh-open-in-editor/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
